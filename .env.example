# Copy to .env (git-ignored). No secrets are required for the headline results.
AGENTJACK_DATA_DIR=./data
AGENTJACK_RESULTS_DIR=./results

# Local open-weight model for the LLM orchestrator (single GPU).
AGENTJACK_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
AGENTJACK_LLM_DEVICE=cuda:0

# Only needed if a closed API model is added as a secondary realism check.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
